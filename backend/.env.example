PORT=5000
RPC_URL=http://127.0.0.1:7545

# To enable real IPFS uploads, fill in valid Infura credentials below.
# If these are left as placeholders, the backend returns a mock IPFS hash for local demo use.
IPFS_PROJECT_ID=YOUR_INFURA_IPFS_PROJECT_ID
IPFS_PROJECT_SECRET=YOUR_INFURA_IPFS_PROJECT_SECRET
